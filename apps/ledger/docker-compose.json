{
  "services": [
    {
      "name": "ledger",
      "image": "ghcr.io/geymayer-apps/ledger-server:0.1.2",
      "isMain": true,
      "internalPort": 8170,
      "environment": [
        {
          "key": "TZ",
          "value": "Europe/Vienna"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
