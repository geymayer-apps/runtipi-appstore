{
  "services": [
    {
      "name": "breadcrumbs",
      "image": "ghcr.io/geymayer-apps/breadcrumbs-server:dev",
      "isMain": true,
      "internalPort": 8160,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "BREADCRUMBS_BACKUP_PASSPHRASE",
          "value": "${BREADCRUMBS_BACKUP_PASSPHRASE}"
        },
        {
          "key": "BREADCRUMBS_RETAIN_DETAILED_DAYS",
          "value": "${BREADCRUMBS_RETAIN_DETAILED_DAYS}"
        },
        {
          "key": "BREADCRUMBS_PUBLIC_URL",
          "value": "${BREADCRUMBS_PUBLIC_URL}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
