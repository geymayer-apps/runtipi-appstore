{
  "services": [
    {
      "name": "home",
      "image": "ghcr.io/geymayer-apps/home-server:0.69.0",
      "isMain": true,
      "internalPort": 8200,
      "restart": "unless-stopped",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "HOME_PUBLIC_URL",
          "value": "${APP_PROTOCOL:-https}://${APP_DOMAIN}"
        },
        {
          "key": "HOME_DATA_DIR",
          "value": "/data"
        },
        {
          "key": "HOME_WEBRTC_HOST",
          "value": "${WEBRTC_HOST}"
        },
        {
          "key": "HOME_WEBRTC_PORT",
          "value": "8557"
        },
        {
          "key": "HOME_SUBNET",
          "value": "${HOME_SUBNET}"
        },
        {
          "key": "HOME_SHELLYS",
          "value": "${HOME_SHELLYS}"
        },
        {
          "key": "HOME_BACKUP_RECIPIENT",
          "value": "${HOME_BACKUP_RECIPIENT}"
        },
        {
          "key": "HOME_APNS_KEY_ID",
          "value": "${HOME_APNS_KEY_ID}"
        },
        {
          "key": "HOME_APNS_TEAM_ID",
          "value": "${HOME_APNS_TEAM_ID}"
        },
        {
          "key": "HOME_NTFY_URL",
          "value": "${HOME_NTFY_URL}"
        },
        {
          "key": "HOME_NTFY_TOKEN",
          "value": "${HOME_NTFY_TOKEN}"
        },
        {
          "key": "HOME_RELEASES_TOKEN",
          "value": "${HOME_RELEASES_TOKEN}"
        },
        {
          "key": "HOME_SETUP_CODE",
          "value": "${HOME_SETUP_CODE}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "hostPort": 8557,
          "containerPort": 8557,
          "tcp": true
        },
        {
          "hostPort": 8557,
          "containerPort": 8557,
          "udp": true
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
